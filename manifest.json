{
  "manifest_version": 3,
  "name": "LinkedIn Easy Apply Automation",
  "version": "1.0",
  "description": "Automação assistida de candidatura simplificada para vagas Remotas e Híbridas",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*"
      ],
      "js": ["content.js"]
    }
  ]
}